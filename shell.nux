@[no_std]

import std::hw;
import std::io;
import std::string;
import std::mem;
import keyboard;
import ramfs;
import edit;
import fm;

# ─── shell.nux — Navi OS Interactive Shell ────────────────────────────────────
#
# Input loop: reads one key at a time via keyboard::read_key().
# Supports:
#   Backspace     Delete character before cursor
#   Ctrl+C        Clear current input buffer (interrupt)
#   Ctrl+L        Clear screen (same as `clear`)
#   Enter         Execute command
#   All printable keys from full QWERTY driver
#
# Commands:
#   help          List commands
#   clear / cls   Clear screen
#   echo <msg>    Print a message
#   uname[-a]     OS info
#   whoami        Current user
#   pwd           Print working directory (always / for now)
#   ls            List files and directories
#   cat <file>    Print file contents
#   touch <file>  Create an empty file
#   rm <file>     Delete a file
#   mkdir <dir>   Create a directory
#   rmdir <dir>   Delete a directory
#   edit <file>   Open file in Nux Editor
#   fm            Open Nux File Manager
#   halt          Halt the CPU

var CMD_BUF:  *u8 = 0x00200000;    # 64 KB command buffer
var CMD_MAX:  u32 = 511;

func _shell_putch(buf: *u8, idx: u32, ch: u8) {
    asm("movb %b2, (%0,%1,1)\n\t" : : "r"(buf), "r"(idx), "q"(ch));
}

func _shell_getch(buf: *u8, idx: u32) -> u8 {
    var c: u8 = 0;
    asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t"
        : "=q"(c) : "r"(buf), "r"(idx) : "%eax");
    return c;
}

# ─── Read input line ──────────────────────────────────────────────────────────
# Fills CMD_BUF with a null-terminated string.
# Returns the length of the entered string.
func _read_line() -> u32 {
    var idx: u32 = 0;

    while (true) {
        var ev      = keyboard::read_key();
        var ascii   = keyboard::key_ascii(ev);
        var special = keyboard::key_special(ev);

        # ── Enter ──────────────────────────────────────────────────────────
        if (ascii == 10 || ascii == 13) {
            io::print_char(10);
            _shell_putch(CMD_BUF, idx, 0);  # null-terminate
            return idx;
        }

        # ── Backspace ──────────────────────────────────────────────────────
        if (ascii == 8 || special == keyboard::KEY_BACKSPACE) {
            if (idx > 0) {
                idx -= 1;
                _shell_putch(CMD_BUF, idx, 0);
                io::print_char(8);   # move cursor back
                io::print_char(32);  # overwrite with space
                io::print_char(8);   # move cursor back again
            }
            continue;
        }

        # ── Ctrl+C: interrupt / clear line ────────────────────────────────
        if (ascii == 3) {  # Ctrl+C = ASCII ETX
            io::print("^C\n");
            io::print("root@navi:~# ");
            idx = 0;
            continue;
        }

        # ── Ctrl+L: clear screen ───────────────────────────────────────────
        if (ascii == 12) {  # Ctrl+L = ASCII FF
            io::clear();
            io::print("root@navi:~# ");
            # Reprint what was typed so far
            var j: u32 = 0;
            while (j < idx) {
                var c = _shell_getch(CMD_BUF, j);
                io::print_char(c);
                j += 1;
            }
            continue;
        }

        # ── Printable characters ───────────────────────────────────────────
        if (ascii >= 32 && ascii < 127) {
            if (idx < CMD_MAX) {
                _shell_putch(CMD_BUF, idx, ascii);
                idx += 1;
                io::print_char(ascii);
            }
            continue;
        }

        # Other special keys (arrows, F-keys) are ignored in the shell
    }
    return 0;
}

# ─── Command Handlers ─────────────────────────────────────────────────────────

func _cmd_ls() {
    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Files:\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    var i: u32 = 0;
    while (i < ramfs::file_count) {
        var fname = ramfs::get_file_name_at(i);
        if (fname != 0) {
            io::print("  ");
            io::print(fname);
            io::print("  (");
            io::print_u32(ramfs::get_file_size(fname));
            io::print(" bytes)\n");
        }
        i += 1;
    }
    io::set_color(io::COLOR_LIGHT_GREEN, io::COLOR_BLACK);
    io::print("Directories:\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    i = 0;
    while (i < ramfs::dir_count) {
        var dname = ramfs::get_dir_name_at(i);
        if (dname != 0) {
            io::print("  /");
            io::print(dname);
            io::print("/\n");
        }
        i += 1;
    }
}

func _cmd_cat(fname: *u8) {
    var data = ramfs::get_file_data(fname);
    if (data == 0) {
        io::print("cat: ");
        io::print(fname);
        io::print(": No such file\n");
        return;
    }
    io::print(data);
    io::print_char(10);
}

func _cmd_touch(fname: *u8) {
    var empty: *u8 = "";
    var ok = ramfs::create_file(fname, empty, 0);
    if (ok == 0) {
        io::print("touch: ");
        io::print(fname);
        io::print(": file already exists\n");
    }
}

func _cmd_rm(fname: *u8) {
    var ok = ramfs::delete_file(fname);
    if (ok == 0) {
        io::print("rm: ");
        io::print(fname);
        io::print(": No such file\n");
    }
}

func _cmd_mkdir(dname: *u8) {
    var ok = ramfs::create_dir(dname);
    if (ok == 0) {
        io::print("mkdir: ");
        io::print(dname);
        io::print(": cannot create directory\n");
    }
}

func _cmd_rmdir(dname: *u8) {
    var ok = ramfs::delete_dir(dname);
    if (ok == 0) {
        io::print("rmdir: ");
        io::print(dname);
        io::print(": No such directory\n");
    }
}

func _cmd_help() {
    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Navi OS — Available Commands\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    io::print("  help           This help message\n");
    io::print("  clear / cls    Clear screen  (also Ctrl+L)\n");
    io::print("  echo <msg>     Print message\n");
    io::print("  uname          OS version\n");
    io::print("  whoami         Current user\n");
    io::print("  pwd            Print working directory\n");
    io::print("  ls             List files and directories\n");
    io::print("  cat <file>     Print file contents\n");
    io::print("  touch <file>   Create empty file\n");
    io::print("  rm <file>      Delete file\n");
    io::print("  mkdir <dir>    Create directory\n");
    io::print("  rmdir <dir>    Delete directory\n");
    io::print("  edit <file>    Open Nux Editor (F1=Nano F2=Vim)\n");
    io::print("  fm             Open Nux File Manager\n");
    io::print("  halt           Halt the system\n");
    io::set_color(io::COLOR_DARK_GREY, io::COLOR_BLACK);
    io::print("  Ctrl+C: interrupt   Ctrl+L: clear screen   Backspace: delete\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
}

# ─── Shell Main Loop ──────────────────────────────────────────────────────────

func start_shell() {
    keyboard::init_keymaps();
    ramfs::init_ramfs();
    ramfs::populate_readme();

    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Welcome to Navi OS\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    io::print("Type 'help' for a list of commands.\n\n");

    while (true) {
        io::set_color(io::COLOR_LIGHT_GREEN, io::COLOR_BLACK);
        io::print("root@navi:~# ");
        io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);

        var len = _read_line();

        if (len == 0) { continue; }

        # ── Dispatch ───────────────────────────────────────────────────────
        if (string::eq(CMD_BUF, "help")) {
            _cmd_help();
        } else if (string::eq(CMD_BUF, "clear") || string::eq(CMD_BUF, "cls")) {
            io::clear();
        } else if (string::eq(CMD_BUF, "pwd")) {
            io::print("/\n");
        } else if (string::eq(CMD_BUF, "whoami")) {
            io::print("root\n");
        } else if (string::eq(CMD_BUF, "uname") || string::eq(CMD_BUF, "uname -a")) {
            io::print("Navi OS 1.0.0 i686 nux (Pure Nux Kernel)\n");
        } else if (string::eq(CMD_BUF, "ls")) {
            _cmd_ls();
        } else if (string::eq(CMD_BUF, "fm")) {
            filemanager_open();
        } else if (string::eq(CMD_BUF, "halt") || string::eq(CMD_BUF, "shutdown")) {
            io::set_color(io::COLOR_YELLOW, io::COLOR_BLACK);
            io::print("System halted. Goodbye.\n");
            io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
            hw::halt_forever();
        } else if (string::starts_with(CMD_BUF, "echo ")) {
            io::print(CMD_BUF + 5);
            io::print_char(10);
        } else if (string::starts_with(CMD_BUF, "cat ")) {
            _cmd_cat(CMD_BUF + 4);
        } else if (string::starts_with(CMD_BUF, "touch ")) {
            _cmd_touch(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "rm ")) {
            _cmd_rm(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "mkdir ")) {
            _cmd_mkdir(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "rmdir ")) {
            _cmd_rmdir(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "edit ")) {
            editor_open(CMD_BUF + 5);
            io::clear();
        } else {
            io::set_color(io::COLOR_LIGHT_RED, io::COLOR_BLACK);
            io::print(CMD_BUF);
            io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
            io::print(": command not found\n");
        }
    }
}
