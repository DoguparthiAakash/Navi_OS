@[no_std]

import std::hw;
import std::io;
import std::string;
import std::mem;
import keyboard;
import ramfs;
import edit;
import fm;
import process;
import memory;
import image_viewer;
import thread;
import vfs;
import pit;

# ─── shell.nux — Navi OS Interactive Shell ────────────────────────────────────
#
# Input loop: reads one key at a time via keyboard::read_key().
# Supports:
#   Backspace     Delete character before cursor
#   Ctrl+C        Clear current input buffer (interrupt)
#   Ctrl+L        Clear screen (same as `clear`)
#   Enter         Execute command
#   All printable keys from full QWERTY driver
#
# Commands:
#   help          List commands
#   clear / cls   Clear screen
#   echo <msg>    Print a message
#   uname[-a]     OS info
#   whoami        Current user
#   pwd           Print working directory (always / for now)
#   ls            List files and directories
#   cat <file>    Print file contents
#   touch <file>  Create an empty file
#   rm <file>     Delete a file
#   mkdir <dir>   Create a directory
#   rmdir <dir>   Delete a directory
#   edit <file>   Open file in Nux Editor
#   fm            Open Nux File Manager
#   df            Show disk (ramfs) free/used space
#   head <file>   Print first 10 lines of file
#   tail <file>   Print last 10 lines of file
#   wc <file>     Print newline, word, and byte counts
#   sleep <ms>    Halt CPU for rough duration
#   ps            List processes
#   kill <pid>    Kill a process
#   bg <cmd>      Start process in background
#   fg <pid>      Bring process to foreground
#   jobs          List background jobs
#   free          Show memory usage
#   cc <file>     Compile and run a C/C++ file (LLVM stub)
#   desktop       Switch to Graphical Desktop Mode
#   view <file>   Open Photo Viewer
#   threads       List all threads
#   vfs-ls        List VFS root directory
#   vfs-tree      Show full VFS directory tree
#   uptime        Show ticks since boot
#   cd <dir>      Change directory
#   halt          Halt the CPU

var CMD_BUF:  *u8 = 0x00200000;    # 64 KB command buffer
var CMD_MAX:  u32 = 511;

var DIR_BUF:  *u8 = 0x00210000;    # Buffer for current directory string
var current_dir: *u8 = "/";


func _shell_putch(buf: *u8, idx: u32, ch: u8) {
    asm("movb %b2, (%0,%1,1)\n\t" : : "r"(buf), "r"(idx), "q"(ch));
}

func _shell_getch(buf: *u8, idx: u32) -> u8 {
    var c: u8 = 0;
    asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t"
        : "=q"(c) : "r"(buf), "r"(idx) : "%eax");
    return c;
}

# ─── Read input line ──────────────────────────────────────────────────────────
# Fills CMD_BUF with a null-terminated string.
# Returns the length of the entered string.
func _read_line() -> u32 {
    var idx: u32 = 0;

    while (true) {
        var ev      = keyboard::read_key();
        var ascii   = keyboard::key_ascii(ev);
        var special = keyboard::key_special(ev);

        # ── Enter ──────────────────────────────────────────────────────────
        if (ascii == 10 || ascii == 13) {
            io::print_char(10);
            _shell_putch(CMD_BUF, idx, 0);  # null-terminate
            return idx;
        }

        # ── Backspace ──────────────────────────────────────────────────────
        if (ascii == 8 || special == keyboard::KEY_BACKSPACE) {
            if (idx > 0) {
                idx -= 1;
                _shell_putch(CMD_BUF, idx, 0);
                io::print_char(8);   # move cursor back
                io::print_char(32);  # overwrite with space
                io::print_char(8);   # move cursor back again
            }
            continue;
        }

        # ── Ctrl+C: interrupt / clear line ────────────────────────────────
        if (ascii == 3) {  # Ctrl+C = ASCII ETX
            io::print("^C\n");
            io::print("root@navi:~> ");
            idx = 0;
            continue;
        }

        # ── Ctrl+L: clear screen ───────────────────────────────────────────
        if (ascii == 12) {  # Ctrl+L = ASCII FF
            io::clear();
            io::print("root@navi:~> ");
            # Reprint what was typed so far
            var j: u32 = 0;
            while (j < idx) {
                var c = _shell_getch(CMD_BUF, j);
                io::print_char(c);
                j += 1;
            }
            continue;
        }

        # ── Printable characters ───────────────────────────────────────────
        if (ascii >= 32 && ascii < 127) {
            if (idx < CMD_MAX) {
                _shell_putch(CMD_BUF, idx, ascii);
                idx += 1;
                io::print_char(ascii);
            }
            continue;
        }

        # Other special keys (arrows, F-keys) are ignored in the shell
    }
    return 0;
}

# ─── Command Handlers ─────────────────────────────────────────────────────────

func _cmd_ls() {
    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Files:\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    var i: u32 = 0;
    while (i < ramfs::file_count) {
        var fname = ramfs::get_file_name_at(i);
        if (fname != 0) {
            io::print("  ");
            io::print(fname);
            io::print("  (");
            io::print_u32(ramfs::get_file_size(fname));
            io::print(" bytes)\n");
        }
        i += 1;
    }
    io::set_color(io::COLOR_LIGHT_GREEN, io::COLOR_BLACK);
    io::print("Directories:\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    i = 0;
    while (i < ramfs::dir_count) {
        var dname = ramfs::get_dir_name_at(i);
        if (dname != 0) {
            io::print("  /");
            io::print(dname);
            io::print("/\n");
        }
        i += 1;
    }
}

func _cmd_cat(fname: *u8) {
    var data = ramfs::get_file_data(fname);
    if (data == 0) {
        io::print("cat: ");
        io::print(fname);
        io::print(": No such file\n");
        return;
    }
    io::print(data);
    io::print_char(10);
}

func _cmd_touch(fname: *u8) {
    var empty: *u8 = "";
    var ok = ramfs::create_file(fname, empty, 0);
    if (ok == 0) {
        io::print("touch: ");
        io::print(fname);
        io::print(": file already exists\n");
    }
}

func _cmd_rm(fname: *u8) {
    var ok = ramfs::delete_file(fname);
    if (ok == 0) {
        io::print("rm: ");
        io::print(fname);
        io::print(": No such file\n");
    }
}

func _cmd_mkdir(dname: *u8) {
    var ok = ramfs::create_dir(dname);
    if (ok == 0) {
        io::print("mkdir: ");
        io::print(dname);
        io::print(": cannot create directory\n");
    }
}

func _cmd_rmdir(dname: *u8) {
    var ok = ramfs::delete_dir(dname);
    if (ok == 0) {
        io::print("rmdir: ");
        io::print(dname);
        io::print(": No such directory\n");
    }
}

func _find_first_space(s: *u8) -> *u8 {
    var i: u32 = 0;
    while (true) {
        var c: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t" : "=q"(c) : "r"(s), "r"(i) : "%eax");
        if (c == 0) { return 0; }
        if (c == 32) { return s + i; }
        i += 1;
    }
    return 0;
}

func _cmd_cp(args: *u8) {
    var space = _find_first_space(args);
    if (space == 0) {
        io::print("cp: missing destination file\n");
        return;
    }
    asm("movb $0, (%0)" : : "r"(space));
    var src = args;
    var dst = space + 1;
    
    var data = ramfs::get_file_data(src);
    if (data == 0) {
        io::print("cp: "); io::print(src); io::print(": No such file\n");
        return;
    }
    var size = ramfs::get_file_size(src);
    var ok = ramfs::create_file(dst, data, size);
    if (ok == 0) {
        io::print("cp: cannot create destination file\n");
    }
}

func _cmd_mv(args: *u8) {
    var space = _find_first_space(args);
    if (space == 0) {
        io::print("mv: missing destination file\n");
        return;
    }
    asm("movb $0, (%0)" : : "r"(space));
    var src = args;
    var dst = space + 1;
    
    var data = ramfs::get_file_data(src);
    if (data == 0) {
        io::print("mv: "); io::print(src); io::print(": No such file\n");
        return;
    }
    var size = ramfs::get_file_size(src);
    var ok = ramfs::create_file(dst, data, size);
    if (ok == 0) {
        io::print("mv: cannot move to destination\n");
        return;
    }
    ramfs::delete_file(src);
}

func _cmd_df() {
    var used: u32 = 0;
    var i: u32 = 0;
    while (i < ramfs::file_count) {
        var fname = ramfs::get_file_name_at(i);
        if (fname != 0) {
            used += ramfs::get_file_size(fname);
        }
        i += 1;
    }
    io::print("Filesystem      Size  Used Avail Use% Mounted on\n");
    io::print("ramfs           64MB  ");
    io::print_u32(used);
    io::print("   ---   ---  /\n");
}

func _cmd_head(fname: *u8) {
    var data = ramfs::get_file_data(fname);
    if (data == 0) { io::print("head: No such file\n"); return; }
    
    var i: u32 = 0;
    var lines: u32 = 0;
    while (lines < 10) {
        var c: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t" : "=q"(c) : "r"(data), "r"(i) : "%eax");
        if (c == 0) { break; }
        io::print_char(c);
        if (c == 10) { lines += 1; }
        i += 1;
    }
    if (lines < 10 && i > 0) { io::print_char(10); }
}

func _cmd_wc(fname: *u8) {
    var data = ramfs::get_file_data(fname);
    if (data == 0) { io::print("wc: No such file\n"); return; }
    
    var size = ramfs::get_file_size(fname);
    var lines: u32 = 0;
    var words: u32 = 0;
    var in_word: u8 = 0;
    
    var i: u32 = 0;
    while (i < size) {
        var c: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t" : "=q"(c) : "r"(data), "r"(i) : "%eax");
        if (c == 10) { lines += 1; }
        if (c == 32 || c == 10 || c == 9 || c == 13) {
            in_word = 0;
        } else if (in_word == 0) {
            in_word = 1;
            words += 1;
        }
        i += 1;
    }
    
    io::print("  "); io::print_u32(lines);
    io::print("  "); io::print_u32(words);
    io::print("  "); io::print_u32(size);
    io::print(" "); io::print(fname); io::print("\n");
}

func _parse_int(s: *u8) -> u32 {
    var res: u32 = 0;
    var i: u32 = 0;
    while (true) {
        var c: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t" : "=q"(c) : "r"(s), "r"(i) : "%eax");
        if (c < 48 || c > 57) { break; }
        res = (res * 10) + (c - 48);
        i += 1;
    }
    return res;
}

func _cmd_kill(args: *u8) {
    var pid = _parse_int(args);
    if (pid == 0) {
        io::print("kill: invalid pid\n");
        return;
    }
    if (pid == 1) {
        io::print("kill: cannot kill init/shell process\n");
        return;
    }
    var ok = process::kill_process(pid);
    if (ok == 1) {
        io::print("Process killed.\n");
    } else {
        io::print("kill: no such process\n");
    }
}

func _cmd_bg(args: *u8) {
    var pid = process::create_process(args);
    if (pid != 0) {
        io::print("["); io::print_u32(pid); io::print("] ");
        io::print(args);
        io::print("\n");
    } else {
        io::print("bg: cannot create process (max limit reached)\n");
    }
}

func _cmd_fg(args: *u8) {
    var pid = _parse_int(args);
    if (pid == 0) { io::print("fg: invalid pid\n"); return; }
    # Dummy implementation for now, just pretend to resume it
    io::print("Resumed process ");
    io::print_u32(pid);
    io::print(" in foreground.\n");
}

func _cmd_cd(args: *u8) {
    # Since ramfs is flat right now, just pretend to change directory
    if (string::eq(args, "/") || string::eq(args, "..")) {
        current_dir = "/";
    } else {
        # Copy to DIR_BUF so it isn't overwritten by CMD_BUF
        var i: u32 = 0;
        while (true) {
            var c: u8 = 0;
            asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t" : "=q"(c) : "r"(args), "r"(i) : "%eax");
            asm("movb %b2, (%0,%1,1)\n\t" : : "r"(DIR_BUF), "r"(i), "q"(c));
            if (c == 0) { break; }
            i += 1;
        }
        current_dir = DIR_BUF;
    }
}

func _cmd_cc(args: *u8) {
    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("LLVM JIT Compiler & Executor (Stub)\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    io::print("Analyzing source: ");
    io::print(args);
    io::print("\n");
    io::print("Error: LLVM backend and standard library not yet ported to Nux!\n");
    io::print("To implement fully in Nux, we must bootstrap a native Nux IR compiler.\n");
}

func _cmd_help() {
    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Navi OS — Available Commands\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    io::print("  help           This help message\n");
    io::print("  clear / cls    Clear screen  (also Ctrl+L)\n");
    io::print("  echo <msg>     Print message\n");
    io::print("  uname          OS version\n");
    io::print("  whoami         Current user\n");
    io::print("  pwd            Print working directory\n");
    io::print("  ls             List files and directories\n");
    io::print("  cat <file>     Print file contents\n");
    io::print("  touch <file>   Create empty file\n");
    io::print("  cp <src> <dst> Copy a file\n");
    io::print("  mv <src> <dst> Move/rename a file\n");
    io::print("  rm <file>      Delete file\n");
    io::print("  mkdir <dir>    Create directory\n");
    io::print("  rmdir <dir>    Delete directory\n");
    io::print("  df             Disk usage\n");
    io::print("  head <file>    Show first 10 lines\n");
    io::print("  wc <file>      Count words/lines\n");
    io::print("  edit <file>    Open Nux Editor (F1=Nano F2=Vim)\n");
    io::print("  fm             Open Nux File Manager\n");
    io::print("  ps             List running processes\n");
    io::print("  kill <pid>     Kill a process by PID\n");
    io::print("  bg <cmd>       Run command as background job\n");
    io::print("  fg <pid>       Bring job to foreground\n");
    io::print("  jobs           List background jobs\n");
    io::print("  free           Show memory usage\n");
    io::print("  cc <file>      Compile/run C/C++ file (LLVM stub)\n");
    io::print("  view <file>    Open image in Photo Viewer\n");
    io::print("  cd <dir>       Change working directory\n");
    io::print("  sleep <ms>     Sleep (dummy loop)\n");
    io::print("  halt           Halt the system\n");
    io::set_color(io::COLOR_DARK_GREY, io::COLOR_BLACK);
    io::print("  Ctrl+C: interrupt   Ctrl+L: clear screen   Backspace: delete\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
}

# ─── Shell Main Loop ──────────────────────────────────────────────────────────

func start_shell() {
    keyboard::init_keymaps();
    ramfs::init_ramfs();
    ramfs::populate_readme();

    io::set_color(io::COLOR_LIGHT_CYAN, io::COLOR_BLACK);
    io::print("Welcome to Navi OS\n");
    io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
    io::print("Type 'help' for a list of commands.\n\n");

    while (true) {
        io::set_color(io::COLOR_LIGHT_GREEN, io::COLOR_BLACK);
        io::print("root@navi:");
        io::set_color(io::COLOR_LIGHT_BLUE, io::COLOR_BLACK);
        io::print(current_dir);
        io::set_color(io::COLOR_LIGHT_GREEN, io::COLOR_BLACK);
        io::print("> ");
        io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);

        var len = _read_line();

        if (len == 0) { continue; }

        # ── Dispatch ───────────────────────────────────────────────────────
        if (string::eq(CMD_BUF, "exit")) {
            return;
        } else if (string::eq(CMD_BUF, "help")) {
            _cmd_help();
        } else if (string::eq(CMD_BUF, "clear") || string::eq(CMD_BUF, "cls")) {
            io::clear();
        } else if (string::eq(CMD_BUF, "pwd")) {
            io::print(current_dir);
            io::print_char(10);
        } else if (string::eq(CMD_BUF, "whoami")) {
            io::print("root\n");
        } else if (string::eq(CMD_BUF, "uname") || string::eq(CMD_BUF, "uname -a")) {
            io::print("Navi OS 1.0.0 i686 nux (Pure Nux Kernel)\n");
        } else if (string::eq(CMD_BUF, "ls")) {
            _cmd_ls();
        } else if (string::eq(CMD_BUF, "fm")) {
            filemanager_open();
        } else if (string::eq(CMD_BUF, "halt") || string::eq(CMD_BUF, "shutdown")) {
            io::set_color(io::COLOR_YELLOW, io::COLOR_BLACK);
            io::print("System halted. Goodbye.\n");
            io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
            hw::halt_forever();
        } else if (string::starts_with(CMD_BUF, "echo ")) {
            io::print(CMD_BUF + 5);
            io::print_char(10);
        } else if (string::starts_with(CMD_BUF, "cat ")) {
            _cmd_cat(CMD_BUF + 4);
        } else if (string::starts_with(CMD_BUF, "touch ")) {
            _cmd_touch(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "cp ")) {
            _cmd_cp(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "mv ")) {
            _cmd_mv(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "rm ")) {
            _cmd_rm(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "mkdir ")) {
            _cmd_mkdir(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "rmdir ")) {
            _cmd_rmdir(CMD_BUF + 6);
        } else if (string::starts_with(CMD_BUF, "head ")) {
            _cmd_head(CMD_BUF + 5);
        } else if (string::starts_with(CMD_BUF, "wc ")) {
            _cmd_wc(CMD_BUF + 3);
        } else if (string::eq(CMD_BUF, "df")) {
            _cmd_df();
        } else if (string::eq(CMD_BUF, "free")) {
            io::print("Total RAM:   32 MB (Mocked)\n");
            io::print("Heap Used:   ");
            io::print_u32(memory::get_allocated_memory());
            io::print(" bytes\n");
        } else if (string::starts_with(CMD_BUF, "cc ")) {
            _cmd_cc(CMD_BUF + 3);
        } else if (string::eq(CMD_BUF, "ps") || string::eq(CMD_BUF, "jobs")) {
            process::print_ps();
        } else if (string::starts_with(CMD_BUF, "kill ")) {
            _cmd_kill(CMD_BUF + 5);
        } else if (string::starts_with(CMD_BUF, "bg ")) {
            _cmd_bg(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "fg ")) {
            _cmd_fg(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "cd ")) {
            _cmd_cd(CMD_BUF + 3);
        } else if (string::starts_with(CMD_BUF, "view ")) {
            image_viewer::open_image(CMD_BUF + 5);
        } else if (string::eq(CMD_BUF, "threads")) {
            thread::print_threads();
        } else if (string::eq(CMD_BUF, "vfs-ls")) {
            vfs::vfs_ls(0);
        } else if (string::eq(CMD_BUF, "vfs-tree")) {
            vfs::vfs_tree();
        } else if (string::eq(CMD_BUF, "uptime")) {
            io::print("Ticks since boot: ");
            io::print_u32(pit::get_ticks());
            io::print(" (100 Hz = 10ms/tick)\n");
        } else if (string::starts_with(CMD_BUF, "sleep ")) {
            # Dummy delay loop
            var k: u32 = 0;
            while (k < 10000000) { k += 1; }
        } else if (string::starts_with(CMD_BUF, "edit ")) {
            editor_open(CMD_BUF + 5);
            io::clear();
        } else {
            io::set_color(io::COLOR_LIGHT_RED, io::COLOR_BLACK);
            io::print(CMD_BUF);
            io::set_color(io::COLOR_WHITE, io::COLOR_BLACK);
            io::print(": command not found\n");
        }
    }
}
