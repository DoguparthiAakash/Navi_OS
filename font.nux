@[no_std]
import std::io;
import fb;

# ─── font.nux — PSF (PC Screen Font) Bitmap Font Renderer ─────────────────────
#
# PSF1 font format:
#   Header (4 bytes): magic[2], mode, charsize
#   Glyph data: 256 glyphs, each `charsize` bytes tall, 8 pixels wide
#
# We embed a minimal 8x16 font for the ASCII printable range (32-127).
# Each character is 8 wide x 16 tall = 16 bytes of bitmap data.
#
# Since we cannot load files from disk yet, we embed the IBM VGA 8x16 font
# data directly. Each byte in the font is one row of 8 horizontal pixels,
# bit 7 = leftmost pixel.

var FONT_WIDTH:    u32 = 8;
var FONT_HEIGHT:   u32 = 16;
var FONT_DATA:     *u8 = 0x01A00000;  # 256 * 16 = 4096 bytes
var FONT_LOADED:   u8  = 0;

# Foreground/background colors for text rendering
var TEXT_FG: u32 = 0xFFFFFF;  # White
var TEXT_BG: u32 = 0x1E1E2E;  # Dark navy (Catppuccin Mocha base)

# ─── Copy font bitmap data to FONT_DATA region ────────────────────────────────
# This copies a minimal hardcoded font for ASCII 32-127.
# A real implementation would load a PSF file from disk.
func _copy_font_byte(idx: u32, val: u8) {
    asm("movb %b2, (%0,%1,1)\n\t" : : "r"(FONT_DATA), "r"(idx), "q"(val));
}

func _load_minimal_font() {
    # Copy from asset_font linked symbol
    var src: *u8 = 0;
    asm("movl $asset_font, %0\n\t" : "=r"(src));
    
    if (src == 0) { return; }
    
    var i: u32 = 0;
    while (i < 4096) {
        var val: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t"
            : "=q"(val) : "r"(src), "r"(i) : "%eax");
        asm("movb %b2, (%0,%1,1)\n\t"
            : : "r"(FONT_DATA), "r"(i), "q"(val));
        i += 1;
    }

    FONT_LOADED = 1;
}

func init_font() {
    _load_minimal_font();
}

# ─── Draw one character glyph to framebuffer ──────────────────────────────────
func font_draw_char(ch: u8, px: u32, py: u32, fg: u32, bg: u32) {
    if (FONT_LOADED == 0) { return; }

    var ascii: u32 = ch as u32;
    if (ascii < 32 || ascii > 127) { ascii = 63; }  # fallback to '?'

    var glyph_base: u32 = 0;
    asm("movl %1, %0\n\t" "imull $16, %0\n\t" : "=r"(glyph_base) : "r"(ascii));

    var row: u32 = 0;
    while (row < FONT_HEIGHT) {
        var glyph_idx: u32 = 0;
        asm("movl %1, %0\n\t" "addl %2, %0\n\t" : "=r"(glyph_idx) : "r"(glyph_base), "r"(row));
        var glyph_byte: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t"
            : "=q"(glyph_byte) : "r"(FONT_DATA), "r"(glyph_idx) : "%eax");

        var col: u32 = 0;
        while (col < FONT_WIDTH) {
            # Check bit (7 - col) of glyph_byte
            var shift: u32 = 7 - col;
            var bit: u8 = 0;
            var zero_r: u32 = 0;
            asm("movzbl %b2, %%eax\n\t" "shrl %b3, %%eax\n\t" "andl $1, %%eax\n\t" "movb %%al, %b0\n\t"
                : "=q"(bit) : "r"(zero_r), "q"(glyph_byte), "c"(shift) : "%eax");
            if (bit != 0) {
                fb::fb_put_pixel(px + col, py + row, fg);
            } else {
                fb::fb_put_pixel(px + col, py + row, bg);
            }
            col += 1;
        }
        row += 1;
    }
}

# ─── Draw a string of text ─────────────────────────────────────────────────────
func font_draw_string(s: *u8, px: u32, py: u32, fg: u32, bg: u32) {
    var i: u32 = 0;
    var x = px;
    while (true) {
        var c: u8 = 0;
        asm("movzbl (%1,%2,1), %%eax\n\t" "movb %%al, %b0\n\t"
            : "=q"(c) : "r"(s), "r"(i) : "%eax");
        if (c == 0) { break; }
        if (c == 10) {  # newline
            # For a real terminal, handle this properly
            break;
        }
        font_draw_char(c, x, py, fg, bg);
        x += FONT_WIDTH;
        i += 1;
    }
}
