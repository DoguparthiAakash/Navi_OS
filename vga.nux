@[no_std]

# VGA Text Mode memory mapped I/O at 0xB8000

var VGA_BUFFER: *u16 = 0xB8000;
var VGA_WIDTH: u32 = 80;
var VGA_HEIGHT: u32 = 25;

var cursor_x: u32 = 0;
var cursor_y: u32 = 0;
var current_color: u8 = 0x0F; # White on Black

# Nux natively supports inline assembly and raw pointer writes.
# We will simulate memory writes assuming the Nux compiler turns `*ptr = val` into a write.

func clear_screen() {
    var y: u32 = 0;
    while (y < VGA_HEIGHT) {
        var x: u32 = 0;
        while (x < VGA_WIDTH) {
            var index: u32 = y * VGA_WIDTH + x;
            # A blank character with the current color
            var char_value: u16 = (current_color << 8) | 0x20; 
            
            *(VGA_BUFFER + index) = char_value;
            
            x += 1;
        }
        y += 1;
    }
    cursor_x = 0;
    cursor_y = 0;
}

func print_char(c: u8) {
    if (c == 10) { # Newline (\n)
        cursor_x = 0;
        cursor_y += 1;
    } else {
        var index: u32 = cursor_y * VGA_WIDTH + cursor_x;
        var char_value: u16 = (current_color << 8) | c;
        *(VGA_BUFFER + index) = char_value;
        
        cursor_x += 1;
    }
    
    # Scroll if we hit the bottom
    if (cursor_x >= VGA_WIDTH) {
        cursor_x = 0;
        cursor_y += 1;
    }
    if (cursor_y >= VGA_HEIGHT) {
        # Primitive scrolling logic omitted for brevity, just reset to top
        clear_screen();
    }
}

func print(str: *u8) {
    var i: u32 = 0;
    # We assume string is null terminated.
    while (true) {
        var c: u8 = *(str + i);
        
        if (c == 0) {
            break;
        }
        print_char(c);
        i += 1;
    }
}
