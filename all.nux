@[no_std]

# memory.nux
# Basic bump allocator for Navi OS

var heap_start: u32 = 0x1000000; # 16 MB mark
var heap_current: u32 = 0x1000000;

func alloc(size: u32) -> *u8 {
    var ptr: u32 = heap_current;
    
    # Align to 4 bytes
    var remainder: u32 = size % 4;
    if (remainder != 0) {
        size = size + (4 - remainder);
    }
    
    heap_current = heap_current + size;
    return ptr as *u8;
}

func free(ptr: *u8) {
    # Bump allocator doesn't free.
    # In a real OS, implement a linked list or buddy allocator.
}
@[no_std]

# VGA Text Mode memory mapped I/O at 0xB8000

var VGA_BUFFER: *u16 = 0xB8000;
var VGA_WIDTH: u32 = 80;
var VGA_HEIGHT: u32 = 25;

var cursor_x: u32 = 0;
var cursor_y: u32 = 0;
var current_color: u8 = 0x0F; # White on Black

# Nux natively supports inline assembly and raw pointer writes.
# We will simulate memory writes assuming the Nux compiler turns `*ptr = val` into a write.

func clear_screen() {
    var y: u32 = 0;
    while (y < VGA_HEIGHT) {
        var x: u32 = 0;
        while (x < VGA_WIDTH) {
            var index: u32 = y * VGA_WIDTH + x;
            # A blank character with the current color
            var char_value: u16 = (current_color << 8) | 0x20; 
            
            *(VGA_BUFFER + index) = char_value;
            
            x += 1;
        }
        y += 1;
    }
    cursor_x = 0;
    cursor_y = 0;
}

func print_char(c: u8) {
    if (c == 10) { # Newline (\n)
        cursor_x = 0;
        cursor_y += 1;
    } else {
        var index: u32 = cursor_y * VGA_WIDTH + cursor_x;
        var char_value: u16 = (current_color << 8) | c;
        *(VGA_BUFFER + index) = char_value;
        
        cursor_x += 1;
    }
    
    # Scroll if we hit the bottom
    if (cursor_x >= VGA_WIDTH) {
        cursor_x = 0;
        cursor_y += 1;
    }
    if (cursor_y >= VGA_HEIGHT) {
        # Primitive scrolling logic omitted for brevity, just reset to top
        clear_screen();
    }
}

func print(str: *u8) {
    var i: u32 = 0;
    # We assume string is null terminated.
    while (true) {
        var c: u8 = *(str + i);
        
        if (c == 0) {
            break;
        }
        print_char(c);
        i += 1;
    }
}
@[no_std]

# Basic PS/2 Keyboard polling via x86 Port I/O (Port 0x60 and 0x64)



func get_scancode() -> u8 {
    # Port 0x64 is the command/status port.
    # We loop until bit 0 (Output Buffer Status) is 1 (data is ready to read).
    while (true) {
        var status = __inb(0x64);
        if ((status & 1) != 0) {
            break;
        }
    }
    
    # Read the actual scancode from Port 0x60
    return __inb(0x60);
}

# Very basic US QWERTY Scancode to ASCII map (simplified)
# We only map a few keys for the demo shell.
func scancode_to_ascii(scancode: u8) -> u8 {
    if (scancode == 0x1E) { return 97; } # 'a'
    if (scancode == 0x30) { return 98; } # 'b'
    if (scancode == 0x2E) { return 99; } # 'c'
    if (scancode == 0x20) { return 100;} # 'd'
    if (scancode == 0x12) { return 101;} # 'e'
    if (scancode == 0x21) { return 102;} # 'f'
    if (scancode == 0x22) { return 103;} # 'g'
    if (scancode == 0x23) { return 104;} # 'h'
    if (scancode == 0x17) { return 105;} # 'i'
    if (scancode == 0x24) { return 106;} # 'j'
    if (scancode == 0x25) { return 107;} # 'k'
    if (scancode == 0x26) { return 108;} # 'l'
    if (scancode == 0x32) { return 109;} # 'm'
    if (scancode == 0x31) { return 110;} # 'n'
    if (scancode == 0x18) { return 111;} # 'o'
    if (scancode == 0x19) { return 112;} # 'p'
    if (scancode == 0x10) { return 113;} # 'q'
    if (scancode == 0x13) { return 114;} # 'r'
    if (scancode == 0x1F) { return 115;} # 's'
    if (scancode == 0x14) { return 116;} # 't'
    if (scancode == 0x16) { return 117;} # 'u'
    if (scancode == 0x2F) { return 118;} # 'v'
    if (scancode == 0x11) { return 119;} # 'w'
    if (scancode == 0x2D) { return 120;} # 'x'
    if (scancode == 0x15) { return 121;} # 'y'
    if (scancode == 0x2C) { return 122;} # 'z'
    
    if (scancode == 0x39) { return 32; } # Space
    if (scancode == 0x1C) { return 10; } # Enter (\n)
    
    return 0; # Unknown / Key release
}
@[no_std]

# fs.nux - Virtual File System structures

class File {
    var name: *u8;
    var data: *u8;
    var size: u32;
}

class Directory {
    var name: *u8;
    var files: *File; # Pointer to array of files for now
    var file_count: u32;
}
@[no_std]

import fs;

# ramfs.nux - Initial RAM File System
# This module reads an archive loaded into memory by GRUB.
# GRUB passes the address of boot modules via the Multiboot struct.

# Hardcoded for the demo: We assume the initrd module is loaded at 0x01000000
# and it contains a flat sequence of files: [Name (16 bytes)][Size (4 bytes)][Data (Size bytes)]

var INITRD_BASE: *u8 = 0x01000000;
var MAX_FILES: u32 = 10;
var root_files: *fs::File = 0x01100000; # Static allocation for file nodes
var root_file_count: u32 = 0;

var root_dir: fs::Directory;

func init_ramfs() {
    # In a real OS, we read the multiboot information struct.
    # For now, we mock parsing an archive from INITRD_BASE.
    
    # We will simulate that there is one file "readme.txt" pre-loaded
    # at INITRD_BASE by our build script.
    
    # Mocking the parsed structure for the shell to use
    var readme_name: *u8 = "readme.txt";
    var readme_data: *u8 = "Welcome to Navi OS!\nThis is a real file stored in NuxFS (RamFS).\n";
    var readme_size: u32 = 65; # Length of the string above
    
    # We simulate populating the root_files array
    # root_files[0].init(readme_name, readme_data, readme_size);
    # Since we can't do array syntax easily without std::collections:
    asm("
        mov %1, %%eax
        mov %%eax, 0(%0)
        mov %2, %%eax
        mov %%eax, 4(%0)
        mov %3, %%eax
        mov %%eax, 8(%0)
    " : : "r"(root_files), "r"(readme_name), "r"(readme_data), "r"(readme_size) : "%eax");
    
    root_file_count = 1;
    
    root_dir.init("/", root_files, root_file_count);
}

func get_root() -> fs::Directory {
    return root_dir;
}
@[no_std]

import vga;
import keyboard;
import ramfs;

# A very minimal string comparison for the shell
func strcmp(s1: *u8, s2: *u8) -> bool {
    var i: u32 = 0;
    while (true) {
        var c1: u8 = 0;
        var c2: u8 = 0;
        asm("mov %1, %%eax; movb (%%eax), %%cl; mov %%cl, %0" : "=r"(c1) : "r"(s1 + i) : "%eax", "%ecx");
        asm("mov %1, %%eax; movb (%%eax), %%cl; mov %%cl, %0" : "=r"(c2) : "r"(s2 + i) : "%eax", "%ecx");
        
        if (c1 != c2) { return false; }
        if (c1 == 0) { return true; }
        i += 1;
    }
    return false;
}

# Starts with prefix comparison
func starts_with(s1: *u8, prefix: *u8) -> bool {
    var i: u32 = 0;
    while (true) {
        var c1: u8 = 0;
        var c2: u8 = 0;
        asm("mov %1, %%eax; movb (%%eax), %%cl; mov %%cl, %0" : "=r"(c1) : "r"(s1 + i) : "%eax", "%ecx");
        asm("mov %1, %%eax; movb (%%eax), %%cl; mov %%cl, %0" : "=r"(c2) : "r"(prefix + i) : "%eax", "%ecx");
        
        if (c2 == 0) { return true; } # Reached end of prefix
        if (c1 != c2) { return false; }
        if (c1 == 0) { return false; }
        i += 1;
    }
    return false;
}

func start_shell() {
    vga::print("Welcome to Navi OS\n");
    vga::print("Type 'help' for commands.\n\n");
    
    # Initialize the RamFS
    ramfs::init_ramfs();
    var root = ramfs::get_root();
    
    var cmd_buffer: *u8 = 0x200000;
    
    while (true) {
        vga::print("root@navi:~# ");
        
        var buf_idx: u32 = 0;
        var cmd_ready = false;
        
        while (!cmd_ready) {
            var scancode = keyboard::get_scancode();
            var ascii = keyboard::scancode_to_ascii(scancode);
            
            if (ascii != 0) {
                if (ascii == 10) { # Enter
                    vga::print_char(10);
                    asm("movb $0, (%0)" : : "r"(cmd_buffer + buf_idx));
                    cmd_ready = true;
                } else {
                    vga::print_char(ascii);
                    asm("movb %b1, (%0)" : : "r"(cmd_buffer + buf_idx), "q"(ascii));
                    buf_idx += 1;
                }
            }
        }
        
        if (buf_idx == 0) {
            continue;
        }
        
        if (strcmp(cmd_buffer, "help")) {
            vga::print("Commands: ls, cat [file], echo [msg], uname, whoami, clear, halt\n");
        } else if (strcmp(cmd_buffer, "ls")) {
            var i: u32 = 0;
            while (i < root.file_count) {
                var fname: *u8 = 0;
                # root.files[i].name
                asm("
                    mov %1, %%eax
                    mov %%eax, %%edx
                    mov 0(%%edx), %%eax
                    mov %%eax, %0
                " : "=r"(fname) : "r"(root.files + (i * 12)) : "%eax", "%edx");
                vga::print(fname);
                vga::print("  ");
                i += 1;
            }
            vga::print("\n");
        } else if (starts_with(cmd_buffer, "cat ")) {
            # Extract filename (skip "cat ")
            var fname: *u8 = cmd_buffer + 4;
            var i: u32 = 0;
            var found = false;
            while (i < root.file_count) {
                var curr_name: *u8 = 0;
                var curr_data: *u8 = 0;
                asm("
                    mov %2, %%eax
                    mov 0(%%eax), %%edx
                    mov %%edx, %0
                    mov 4(%%eax), %%edx
                    mov %%edx, %1
                " : "=r"(curr_name), "=r"(curr_data) : "r"(root.files + (i * 12)) : "%eax", "%edx");
                
                if (strcmp(fname, curr_name)) {
                    vga::print(curr_data);
                    vga::print("\n");
                    found = true;
                    break;
                }
                i += 1;
            }
            if (!found) {
                vga::print("cat: ");
                vga::print(fname);
                vga::print(": No such file or directory\n");
            }
        } else if (starts_with(cmd_buffer, "echo ")) {
            vga::print(cmd_buffer + 5);
            vga::print("\n");
        } else if (strcmp(cmd_buffer, "uname") || strcmp(cmd_buffer, "uname -a")) {
            vga::print("Navi OS 1.0.0 i686 (Pure Nux Kernel)\n");
        } else if (strcmp(cmd_buffer, "whoami")) {
            vga::print("root\n");
        } else if (strcmp(cmd_buffer, "clear")) {
            vga::clear_screen();
        } else if (strcmp(cmd_buffer, "halt")) {
            vga::print("System halted.\n");
            asm("cli; hlt");
        } else {
            vga::print("bash: ");
            vga::print(cmd_buffer);
            vga::print(": command not found\n");
        }
    }
}
@[no_std]

import vga;
import shell;
import fs;
import ramfs;

# The entry point called by boot.s
@[entry]
func kmain() {
    # Initialize hardware drivers
    vga::clear_screen();
    
    # Hand off execution to the interactive shell
    shell::start_shell();
    
    # We should never return here, but just in case:
    asm("cli; hlt");
}
